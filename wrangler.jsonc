{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marvel-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *", "43 4 * * 1"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only these go through the Worker; files and pages come straight from the assets, with the
    // headers of public/_headers.
    "run_worker_first": ["/api/*", "/film/*", "/robots.txt", "/sitemap.xml"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marvel-planner",
      "database_id": "cb44769e-5478-4be4-a3e4-825fc2bcb53a",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://marvel-planner.diegosantigiuseppe.workers.dev",
  },
}
